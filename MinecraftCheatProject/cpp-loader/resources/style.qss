QMainWindow {
    background-color: #2b2b2b;
    color: #ffffff;
}

QLabel {
    color: #ffffff;
    font-size: 14px;
}

QPushButton {
    background-color: #007acc;
    color: #ffffff;
    border: none;
    padding: 10px;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #158ce0;
}

QLineEdit, QComboBox, QTextEdit {
    background-color: #3a3a3a;
    color: #ffffff;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 6px;
}

QTextEdit {
    font-family: Consolas, monospace;
}
